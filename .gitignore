# 2026-09-03: 234MB of .doc/.docx/.epub/.gif were committed via "Initial commit from zip";
# untracked them (git rm --cached) — they stay on disk, just out of git.
guangdong-zhuanshengben-resources/**/*.doc
guangdong-zhuanshengben-resources/**/*.docx
guangdong-zhuanshengben-resources/**/*.epub
guangdong-zhuanshengben-resources/**/*.gif
guangdong-zhuanshengben-resources/**/*.pdf
