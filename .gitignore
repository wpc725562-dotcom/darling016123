# Obsidian workspace / local state (device-specific)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json
.obsidian/cache
.obsidian/plugins/*/data.json

# Trash / temp
.obsidian-mcp-trash/
.trash/
*.tmp
*.temp
~*

# Local learning DB / scripts not part of notes
mtool_learning_state.db
*.db

# OS
.DS_Store
Thumbs.db
desktop.ini

# Large media (keep notes only)
*.mp4
*.mkv
*.avi
*.mov
*.zip
*.rar
*.7z

# Node / VitePress
node_modules/
docs/.vitepress/dist/
# 绕沙箱批量删除保护时用的临时输出目录（distX / distY），构建完记得删
docs/.vitepress/dist*/
# 构建被打断时残留的临时配置文件
docs/.vitepress/config.mts.timestamp-*.mjs
docs/.vitepress/cache/
docs/.vitepress/*.timestamp-*.mjs
docs/.vitepress/config.mts.timestamp-*.mjs
package-lock.json.bak
# 改脚本前的本地备份（2026-09-19 起用 <name>.bak-YYYYMMDD 命名）
# .bak-* = 转换前的源（回归基线）；.orig-* = 前置搬运前的原件。
#   ★ 脚本自己的备份只留本地；**真题页的基线与原件必须入库**，见下面两条例外。
*.bak-*
*.orig-*

# ★ 例外（2026-09-20）：真题页的回归基线 / 原件纳入版本控制。
#
#   为什么必须入库：zhenti_regress.py 的默认检查是「拿 <页面>.bak-* 当输入，
#   用当前转换器重跑，期望逐字节复现线上页面」。基线不入库 ⇒ 换机器 / 重新克隆
#   之后 24 份页面全部走 NOBAK 分支 ⇒ 回归会报「24/24 复现一致 · 退出码 0」，
#   而实际上一次字节比对都没做。（2026-09-19 审计实测确认。）
#
#   为什么不影响别的：这两条只对 docs/posts/ 生效。scripts/*.bak-*、
#   *.log 之类的本地备份照旧被上面的规则挡住。
#
#   体积：34 个 .bak + 9 个 .orig，共约 0.8 MB。
!docs/posts/**/*.bak-*
!docs/posts/**/*.orig-*
*.log
.npm/

# 巡逻自检脚本的临时目录（scripts/test-patrol-logic.sh）。
# 本机沙箱会拦截批量删除，该目录可能残留，故必须忽略。
.tmp-patrol-test/

# Large local study materials (keep on disk, don't push)
*.pdf
*.png
!docs/public/**/*.png
资料/英语真题原卷/_extract/
资料/英语真题原卷/_by_year/
# keep small helper scripts & md under 资料/
!资料/**/*.md
!资料/**/*.py
# site-embedded exam PDFs (split by year for the blog)
!docs/public/papers/**/*.pdf

# 2026 精编讲义 & 黄金知识汇编（用户要求纳入版本管理，2026-08-22）
!资料/2026精编讲义/*.pdf
!资料/2026黄金知识汇编/*.pdf
__pycache__/
资料/**/*.docx
资料/**/*.txt
!资料/**/*.md
!资料/**/*.py

# ForestDeer / external raw cache must never enter notes git
# (actual cache lives outside repo at D:/专升本/_pdf_cache/ — belt & suspenders)
_pdf_cache/
**/_pdf_cache/

# ForestDeer clone: keep .txt/.md text versions tracked, block binaries.
# 2026-09-03: 234MB of .doc/.docx/.epub/.gif were committed via "Initial commit from zip";
# untracked them (git rm --cached) — they stay on disk, just out of git.
guangdong-zhuanshengben-resources/**/*.doc
guangdong-zhuanshengben-resources/**/*.docx
guangdong-zhuanshengben-resources/**/*.epub
guangdong-zhuanshengben-resources/**/*.gif
guangdong-zhuanshengben-resources/**/*.pdf
# OCR intermediate dumps if someone copies them under notes root
**/_ocr_raw/
**/*_tesseract.txt
**/*_rapidocr.txt

# ForestDeer 本地资源副本（大文件，不推送）
guangdong-zhuanshengben-resources/


# Obsidian 误建的空库
zsb/

# B站视频解析产物（音频 / 画面帧 / 逐字稿）—— 本地用，不推送
# 见 scripts/bili_analyze.py。注意 *.jpg / *.m4s 不在上面的通用媒体规则里，必须单独挡。
data/bili-analyze/

# 真题讲解抓取产物（字幕轨 / 画面帧 / 逐字稿 / 真题卡）—— 同上，本地用
# 见 scripts/bili_zhenti.py。★ 只有重写后的 notes/*.md 会进 docs/，原始产物一律不进站。
data/bili-zhenti/

# 真题考点抽取与章节归并的中间产物（topics.json / analysis.json / 日志）—— 本地用
# 见 data/zhenti-extract/*.py。结论已写进 docs/posts/高频考点/真题考点总析.md，产物本身不进站。
data/zhenti-extract/

# 从站内真题 PDF 抽正文的中间产物（文字层 txt / 300dpi 页面渲染 png / 逐题比对脚本）—— 本地用
# 见 data/english-pdf/*.py。★ 原始 PDF 本身在 docs/public/papers/ 下，**是入库的**；
# 这里只放「抽取结果 + 复核脚本」，产物本身不进站。
data/english-pdf/

# ★ B站登录态凭证 —— 绝不能进仓库（等于把账号交出去）
.bili-sessdata
**/.bili-sessdata
# bili_login.py 在终端乱码时落出的二维码页面，属临时产物
bili-qr.html

# WorkBuddy AI agent 的本地工作记忆 / 自动化执行记录 —— 本地状态，不进仓库
# 与上面 .obsidian/workspace.json 同理：设备相关、随时会变、对他人无意义。
# 2026-09-21 补：此前这 2 个文件一直以 ?? 状态挂在 git status 里。
.workbuddy-ai/


# 本地预览用的目录联接（指向 docs/.vitepress/dist）—— 构建产物，不进仓库
# 2026-09-21 补：此前它以数千个 ?? 的形式污染 git status。
data/preview-root/
