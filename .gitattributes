# 统一换行符：所有文本文件入库规范化为 LF，杜绝 CRLF/LF 幻影修改
* text=auto

# 明确的二进制类型（防止误规范化）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
*.db binary

# 2026-09-17 补充：其余二进制类型（此前未声明，存在被误当文本规范化的风险）
*.bmp binary
*.tif binary
*.tiff binary
*.otf binary
*.eot binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary
*.epub binary
*.rar binary
*.7z binary
*.tar binary
*.mp4 binary
*.mov binary
*.mkv binary
*.avi binary
*.mp3 binary
*.wav binary

